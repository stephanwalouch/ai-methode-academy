# Supabase – aus deinem Supabase-Dashboard unter Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Nur serverseitig – Service-Role-Key (niemals im Frontend verwenden!)
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Bunny.net – aus deinem Bunny-Dashboard
NEXT_PUBLIC_BUNNY_LIBRARY_ID=123456

# Basis-URL der App (für Einladungslinks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
